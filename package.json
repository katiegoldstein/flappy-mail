{
  "name": "flappy-mail",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "vitest run",
    "geo": "node scripts/build-geo.mjs",
    "icons": "node --experimental-strip-types --no-warnings scripts/make-icons.ts",
    "dev:site": "vite",
    "db:migrate": "wrangler d1 migrations apply flappy-mail --local",
    "typecheck": "tsc -p . && tsc -p worker",
    "seed": "node scripts/seed-local.mjs",
    "db:reset": "wrangler d1 execute flappy-mail --local --command \"DELETE FROM letters; DELETE FROM outbox; DELETE FROM sea_routes;\"",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply flappy-mail --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^22.20.5",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
